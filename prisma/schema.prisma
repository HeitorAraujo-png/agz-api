generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum MemberLevel {
  USER
  ORGANIZER
  ADMIN
  PRESIDENT
  SUPER_ADMIN
}

model Member {
  id                  String              @id @default(uuid()) @db.Char(36)
  memberId            String              @unique @db.VarChar(10)
  username            String              @unique @db.VarChar(80)
  email               String              @unique @db.VarChar(255)
  phone               String?             @db.VarChar(15)
  passwordHash        String              @db.VarChar(255)
  level               MemberLevel         @default(USER)
  active              Boolean             @default(true)
  mustChangePassword  Boolean             @default(true)
  dependents          Dependent[]
  reservations        Reservation[]
  refreshTokens       RefreshToken[]
  resetTokens         PasswordResetToken[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model Dependent {
  id        Int      @id @default(autoincrement())
  memberId  String   @db.Char(36)
  name      String   @db.VarChar(255)
  active    Boolean  @default(true)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  reservations ReservationDependent[]
  createdAt DateTime @default(now())
}

model Reservation {
  id          String                 @id @default(uuid()) @db.Char(36)
  memberId    String                 @db.Char(36)
  date        DateTime               @db.Date
  kioskNumber Int
  member      Member                 @relation(fields: [memberId], references: [id], onDelete: Cascade)
  dependents  ReservationDependent[]
  createdAt   DateTime               @default(now())
  @@unique([memberId, date])
  @@unique([date, kioskNumber])
  @@index([date])
}

model ReservationDependent {
  reservationId String      @db.Char(36)
  dependentId   Int
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  dependent     Dependent   @relation(fields: [dependentId], references: [id], onDelete: Restrict)
  @@id([reservationId, dependentId])
}

model Event {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String   @db.VarChar(70)
  date        DateTime @unique @db.Date
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Rental {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @db.VarChar(150)
  startDate DateTime @db.Date
  eventDate DateTime @db.Date
  endDate   DateTime @db.Date
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  @@index([startDate, eventDate, endDate])
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Char(36)
  memberId  String   @db.Char(36)
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime
  revokedAt DateTime?
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Char(36)
  memberId  String   @db.Char(36)
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
